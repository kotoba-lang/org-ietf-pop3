{:paths ["src"]
 :deps {}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; TEST-ONLY. Parity compiles kotoba/pop3/session.kotoba
                      ;; and runs it against pop3.client. Nothing in :paths
                      ;; depends on either of these.
                      ;;
                      ;; Pins are the west pair (amu + kotoba-kir) as of this
                      ;; commit; they are advanced together.
                      ;;
                      ;; Advanced with the annotation removal in kotoba/: the
                      ;; guest now relies on the frontend inferring a
                      ;; parameter's type from its use and a result's from its
                      ;; body, and on annotation being per-parameter. The
                      ;; previous pin refuses the result outright --
                      ;; `typed parameters require alternating name/type pairs`
                      ;; (measured, on the minimised source).
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "27d82d8593b99b5ca95d09351bf6ff04f97c2ffd"}
                      io.github.kotoba-lang/kotoba-kir
                      {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                       :git/sha "b6bfe238396631ff4b61934264a919f8ae5236b7"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; The .cljc suite alone, with no compiler dependency.
  :test-pure
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"
               "-n" "pop3.protocol-test"
               "-n" "pop3.client-test"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
